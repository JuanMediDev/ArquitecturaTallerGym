@model ClienteListaViewModel
@using Gimnasio.Negocio.Entidades
@{
    ViewData["Title"] = "Clientes";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-3 mb-4">
    <div>
        <p class="display-kicker mb-2">Personas</p>
        <h1 class="section-heading mb-0">Clientes</h1>
        <p class="text-secondary mt-2 mb-0">Administra los perfiles y consulta su historial.</p>
    </div>
    <a class="btn btn-accent" asp-action="Crear">Registrar cliente</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}

<div class="table-responsive rounded-3 border border-secondary">
    <table class="table table-dark table-hover align-middle mb-0">
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Documento</th>
                <th>Correo</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Clientes.Count == 0)
            {
                <tr><td colspan="5" class="py-4 text-center text-secondary">Aún no hay clientes registrados.</td></tr>
            }
            else
            {
                @foreach (var cliente in Model.Clientes)
                {
                    <tr>
                        <td class="fw-semibold">@cliente.Nombre</td>
                        <td>@cliente.Documento</td>
                        <td>@cliente.Correo</td>
                        <td><span class="badge @(cliente.Estado == EstadoCliente.Activo ? "text-bg-success" : "text-bg-secondary")">@cliente.Estado</span></td>
                        <td class="text-end text-nowrap">
                            <a class="btn btn-sm btn-outline-light" asp-action="Detalle" asp-route-id="@cliente.Id">Detalle</a>
                            <a class="btn btn-sm btn-outline-light" asp-action="Editar" asp-route-id="@cliente.Id">Editar</a>
                            <form asp-action="CambiarEstado" asp-route-id="@cliente.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="estado" value="@(cliente.Estado == EstadoCliente.Activo ? EstadoCliente.Inactivo : EstadoCliente.Activo)" />
                                <button type="submit" class="btn btn-sm btn-outline-warning">@(cliente.Estado == EstadoCliente.Activo ? "Desactivar" : "Activar")</button>
                            </form>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>
