@model ClienteDetalleViewModel
@using Gimnasio.Negocio.Entidades
@{
    ViewData["Title"] = "Detalle del cliente";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-start gap-3 mb-4">
    <div>
        <p class="display-kicker mb-2">Perfil de cliente</p>
        <h1 class="section-heading mb-2">@Model.Nombre</h1>
        <span class="badge @(Model.Estado == EstadoCliente.Activo ? "text-bg-success" : "text-bg-secondary")">@Model.Estado</span>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-light" asp-action="Index">Volver a clientes</a>
        <a class="btn btn-outline-light" asp-controller="Membresias" asp-action="PorCliente" asp-route-clienteId="@Model.Id">Ver membresías</a>
        <a class="btn btn-accent" asp-action="Editar" asp-route-id="@Model.Id">Editar perfil</a>
    </div>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}

<section class="module-card mb-4" aria-labelledby="datos-heading">
    <h2 class="section-heading" id="datos-heading">Datos de contacto</h2>
    <dl class="row mb-0">
        <dt class="col-sm-3 text-secondary">Documento</dt><dd class="col-sm-9">@Model.Documento</dd>
        <dt class="col-sm-3 text-secondary">Correo</dt><dd class="col-sm-9">@Model.Correo</dd>
        <dt class="col-sm-3 text-secondary">Teléfono</dt><dd class="col-sm-9">@Model.Telefono</dd>
    </dl>
</section>

<div class="d-flex flex-column flex-sm-row align-items-sm-end justify-content-between gap-2 mb-3">
    <div>
        <p class="display-kicker mb-2">Historial</p>
        <h2 class="section-heading mb-0">Membresías y pagos</h2>
    </div>
    <form asp-action="CambiarEstado" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="estado" value="@(Model.Estado == EstadoCliente.Activo ? EstadoCliente.Inactivo : EstadoCliente.Activo)" />
        <button type="submit" class="btn btn-outline-warning">@(Model.Estado == EstadoCliente.Activo ? "Desactivar cliente" : "Activar cliente")</button>
    </form>
</div>

@if (Model.Membresias.Count == 0)
{
    <div class="module-card text-secondary">Este cliente aún no tiene membresías registradas.</div>
}
else
{
    <div class="d-grid gap-3">
        @foreach (var membresia in Model.Membresias)
        {
            <section class="module-card">
                <div class="d-flex flex-wrap justify-content-between gap-2 mb-3">
                    <h3 class="h5 mb-0">@membresia.Plan</h3>
                    <span class="badge text-bg-secondary">@membresia.Estado</span>
                </div>
                <p class="text-secondary">Vigencia: @membresia.FechaInicio.ToString("dd/MM/yyyy") – @membresia.FechaFin.ToString("dd/MM/yyyy")</p>
                <h4 class="h6 fw-bold">Pagos</h4>
                @if (membresia.Pagos.Count == 0)
                {
                    <p class="text-secondary mb-0">No hay pagos asociados a esta membresía.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-sm align-middle mb-0">
                            <thead><tr><th>Fecha</th><th>Método</th><th>Estado</th><th class="text-end">Monto</th></tr></thead>
                            <tbody>
                                @foreach (var pago in membresia.Pagos)
                                {
                                    <tr>
                                        <td>@pago.FechaPago.ToString("dd/MM/yyyy")</td>
                                        <td>@pago.MetodoPago</td>
                                        <td>@pago.Estado</td>
                                        <td class="text-end">@pago.Monto.ToString("C")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
    </div>
}
