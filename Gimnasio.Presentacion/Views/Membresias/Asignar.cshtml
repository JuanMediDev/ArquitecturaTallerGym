@model AsignarMembresiaViewModel
@{
    ViewData["Title"] = "Asignar membresía";
}

<p class="display-kicker mb-2">Membresías / Nueva asignación</p>
<h1 class="section-heading">Asignar membresía</h1>
<p class="text-secondary mb-4">Elige un cliente, un plan y la fecha de inicio. La fecha de finalización se calcula según la duración del plan.</p>

<div class="module-card">
    @if (Model.Clientes.Count == 0)
    {
        <div class="alert alert-warning" role="status">Registra un cliente antes de asignarle una membresía.</div>
        <a class="btn btn-accent" asp-controller="Clientes" asp-action="Crear">Registrar cliente</a>
    }
    else if (Model.Planes.Count == 0)
    {
        <div class="alert alert-warning" role="status">Crea un plan antes de asignarlo a un cliente.</div>
        <a class="btn btn-accent" asp-action="CrearPlan">Crear plan</a>
    }
    else
    {
        <form asp-action="Asignar" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="ClienteId" class="form-label"></label>
                    <select asp-for="ClienteId" asp-items="Model.Clientes" class="form-select">
                        <option value="0">Selecciona un cliente</option>
                    </select>
                    <span asp-validation-for="ClienteId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PlanId" class="form-label"></label>
                    <select asp-for="PlanId" asp-items="Model.Planes" class="form-select">
                        <option value="0">Selecciona un plan</option>
                    </select>
                    <span asp-validation-for="PlanId" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FechaInicio" class="form-label"></label>
                    <input asp-for="FechaInicio" class="form-control" />
                    <span asp-validation-for="FechaInicio" class="text-danger"></span>
                </div>
                <div class="col-12 d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-accent">Confirmar asignación</button>
                    <a asp-action="Planes" class="btn btn-outline-light">Volver a planes</a>
                </div>
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
