@model IReadOnlyList<PlanFormViewModel>
@{
    ViewData["Title"] = "Planes de membresía";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-3 mb-4">
    <div>
        <p class="display-kicker mb-2">Planes y vigencias</p>
        <h1 class="section-heading mb-0">Membresías</h1>
        <p class="text-secondary mt-2 mb-0">Define opciones de acceso y asígnalas a tus clientes.</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-light" asp-action="Asignar">Asignar membresía</a>
        <a class="btn btn-accent" asp-action="CrearPlan">Crear plan</a>
    </div>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}

@if (Model.Count == 0)
{
    <div class="module-card text-secondary">Todavía no hay planes. Crea el primero para poder asignar una membresía.</div>
}
else
{
    <div class="row g-3">
        @foreach (var plan in Model)
        {
            <div class="col-md-6 col-xl-4">
                <article class="module-card h-100">
                    <span class="module-number">PLAN DE MEMBRESÍA</span>
                    <h2 class="h4 fw-bold">@plan.Nombre</h2>
                    <p class="text-secondary">@plan.DuracionDias días de vigencia</p>
                    <p>@plan.Beneficios</p>
                    <p class="display-6 fw-bold mb-0">@plan.Precio.ToString("C")</p>
                </article>
            </div>
        }
    </div>
}
