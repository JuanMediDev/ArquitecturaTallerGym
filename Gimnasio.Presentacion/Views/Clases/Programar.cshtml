@model ClaseFormViewModel
@{
    ViewData["Title"] = "Programar clase";
}

<p class="display-kicker mb-2">Entrenamiento grupal / Nueva sesión</p>
<h1 class="section-heading">Programar clase</h1>
<p class="text-secondary mb-4">Cada clase corresponde a una sesión con fecha y horario concretos.</p>

<div class="module-card">
    @if (Model.Instructores.Count == 0)
    {
        <div class="alert alert-warning" role="status">No hay instructores disponibles para programar una clase.</div>
    }
    else
    {
        <form asp-action="Programar" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Nombre" class="form-label"></label>
                    <input asp-for="Nombre" class="form-control" />
                    <span asp-validation-for="Nombre" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="InstructorId" class="form-label"></label>
                    <select asp-for="InstructorId" asp-items="Model.Instructores" class="form-select">
                        <option value="0">Selecciona un instructor</option>
                    </select>
                    <span asp-validation-for="InstructorId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="FechaHoraInicio" class="form-label"></label>
                    <input asp-for="FechaHoraInicio" class="form-control" type="datetime-local" />
                    <span asp-validation-for="FechaHoraInicio" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="FechaHoraFin" class="form-label"></label>
                    <input asp-for="FechaHoraFin" class="form-control" type="datetime-local" />
                    <span asp-validation-for="FechaHoraFin" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="CupoMaximo" class="form-label"></label>
                    <input asp-for="CupoMaximo" class="form-control" />
                    <span asp-validation-for="CupoMaximo" class="text-danger"></span>
                </div>
                <div class="col-12 d-flex flex-wrap gap-2 mt-4">
                    <button type="submit" class="btn btn-accent">Guardar programación</button>
                    <a asp-action="Index" class="btn btn-outline-light">Cancelar</a>
                </div>
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
