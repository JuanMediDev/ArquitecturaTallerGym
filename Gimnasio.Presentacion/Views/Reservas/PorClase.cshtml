@model ReservaClaseViewModel
@using Gimnasio.Negocio.Entidades
@{
    ViewData["Title"] = "Reservas de la clase";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-3 mb-4">
    <div>
        <p class="display-kicker mb-2">Reservas y asistencia</p>
        <h1 class="section-heading mb-1">@Model.NombreClase</h1>
        <p class="text-secondary mb-0">@Model.NombreInstructor · @Model.FechaHoraInicio.ToString("dddd dd/MM/yyyy · HH:mm")–@Model.FechaHoraFin.ToString("HH:mm")</p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-outline-light" asp-action="PorClase">Elegir otra clase</a>
        <a class="btn btn-accent" asp-action="Reservar" asp-route-claseId="@Model.ClaseId">Nueva reserva</a>
    </div>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}

<div class="module-card mb-4">
    <p class="display-kicker mb-2">Ocupación</p>
    <p class="h4 fw-bold mb-0">@Model.ReservasActivas / @Model.CupoMaximo <span class="text-secondary fs-6 fw-normal">lugares reservados</span></p>
</div>

@if (Model.Reservas.Count == 0)
{
    <div class="module-card text-secondary">No hay reservas para esta clase todavía.</div>
}
else
{
    <div class="table-responsive rounded-3 border border-secondary">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead><tr><th>Cliente</th><th>Fecha de reserva</th><th>Estado</th><th>Asistencia</th><th class="text-end">Acciones</th></tr></thead>
            <tbody>
                @foreach (var reserva in Model.Reservas)
                {
                    <tr>
                        <td class="fw-semibold">@reserva.NombreCliente</td>
                        <td>@reserva.FechaReserva.ToString("dd/MM/yyyy HH:mm")</td>
                        <td><span class="badge @(reserva.Estado == EstadoReserva.Activa ? "text-bg-success" : "text-bg-secondary")">@reserva.Estado</span></td>
                        <td>@(reserva.TieneAsistencia ? "Registrada" : "Pendiente")</td>
                        <td class="text-end text-nowrap">
                            @if (reserva.Estado == EstadoReserva.Activa)
                            {
                                <form asp-action="RegistrarAsistencia" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="clienteId" value="@reserva.ClienteId" />
                                    <input type="hidden" name="claseId" value="@Model.ClaseId" />
                                    <button type="submit" class="btn btn-sm btn-outline-success" disabled="@reserva.TieneAsistencia">Registrar asistencia</button>
                                </form>
                                <form asp-action="Cancelar" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@reserva.Id" />
                                    <input type="hidden" name="claseId" value="@Model.ClaseId" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning">Cancelar</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
