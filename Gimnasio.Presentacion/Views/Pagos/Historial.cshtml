@model PagoHistorialViewModel
@{
    ViewData["Title"] = "Historial de pagos";
}

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-end gap-3 mb-4">
    <div>
        <p class="display-kicker mb-2">Ingresos / Registro</p>
        <h1 class="section-heading mb-0">Historial de pagos</h1>
        <p class="text-secondary mt-2 mb-0">Consulta los pagos conservados por cliente y membresía.</p>
    </div>
    <a class="btn btn-accent" asp-action="Registrar" asp-route-clienteId="@Model.ClienteId">Registrar pago</a>
</div>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success" role="status">@mensaje</div>
}

<section class="module-card mb-4">
    <form asp-action="Historial" method="get" class="row g-3 align-items-end">
        <div class="col-md-8">
            <label class="form-label" for="cliente-historial">Cliente</label>
            <select class="form-select" id="cliente-historial" name="clienteId" asp-items="Model.Clientes">
                <option value="">Selecciona un cliente</option>
            </select>
        </div>
        <div class="col-md-4">
            <button class="btn btn-outline-light" type="submit">Consultar historial</button>
        </div>
    </form>
</section>

@if (Model.ClienteId.HasValue)
{
    <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
        <div>
            <p class="display-kicker mb-2">Cliente</p>
            <h2 class="section-heading mb-0">@Model.NombreCliente</h2>
        </div>
        <span class="text-secondary">@Model.Pagos.Count registro(s)</span>
    </div>

    @if (Model.Pagos.Count == 0)
    {
        <div class="module-card text-secondary">Este cliente todavía no tiene pagos registrados.</div>
    }
    else
    {
        <div class="table-responsive rounded-3 border border-secondary">
            <table class="table table-dark table-hover align-middle mb-0">
                <thead><tr><th>Fecha</th><th>Membresía</th><th>Método</th><th>Estado</th><th class="text-end">Monto</th></tr></thead>
                <tbody>
                    @foreach (var pago in Model.Pagos)
                    {
                        <tr>
                            <td>@pago.FechaPago.ToString("dd/MM/yyyy HH:mm")</td>
                            <td><a asp-controller="Membresias" asp-action="PorCliente" asp-route-clienteId="@Model.ClienteId">#@pago.MembresiaId</a></td>
                            <td>@pago.MetodoPago</td>
                            <td><span class="badge @(pago.Estado == Gimnasio.Negocio.Entidades.EstadoPago.Registrado ? "text-bg-success" : "text-bg-secondary")">@pago.Estado</span></td>
                            <td class="text-end">@pago.Monto.ToString("C")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}
